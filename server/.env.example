# Para desenvolvimento local (npm run dev). Copie para ".env" nesta pasta.
DATABASE_URL=file:./data/dev.db
APP_USER=admin
APP_PASSWORD=dev123
SESSION_SECRET=dev-secret-change-me-please-1234567890abcdef
COOKIE_SECURE=false
PORT=8080

# Alertas (opcionais). Sem eles os alertas aparecem só no app.
# Na VM, use ops/set-alert-secrets.sh para gravar estes valores sem expô-los.
# TELEGRAM_BOT_TOKEN=          # token do bot criado no @BotFather; a conversa é vinculada pelo app
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=                   # no Gmail, uma "senha de app"
# ALERT_EMAIL_TO=
# ALERT_DIGEST_AT=07:30        # horário do resumo diário (Brasília)
# APP_URL=https://financeiro.example.com
