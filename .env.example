# Copie este arquivo para ".env" e ajuste os valores antes de subir o container.

# Credenciais do único usuário do sistema.
APP_USER=admin
APP_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão (JWT). Gere um valor aleatório, ex.:
#   openssl rand -hex 32
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Defina como "true" somente quando o app estiver atrás de HTTPS (Nginx/Caddy com TLS).
# Em "true", o cookie de sessão só é enviado em conexões HTTPS.
COOKIE_SECURE=false

# Porta exposta no host (docker-compose). A aplicação escuta internamente na porta 8080.
HOST_PORT=8080

# ── Open Finance (Pluggy / MeuPluggy) ── opcional; sem estas chaves a sincronização fica desligada.
# Credenciais da aplicação criada em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional: ids de itens (separados por vírgula) a sincronizar além dos já registrados no banco.
PLUGGY_ITEM_IDS=
# Opcional: intervalo entre sincronizações automáticas (horas) e histórico da primeira carga (dias).
PLUGGY_SYNC_INTERVAL_HOURS=6
PLUGGY_HISTORY_DAYS=365

# ── Alertas (Telegram e e-mail) ── opcional. Também dá para configurar pela aba Alertas do app;
# o que for gravado lá vale mais do que estas variáveis.
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Um ou mais destinatários, separados por vírgula.
ALERT_EMAIL_TO=
# Endereço do app, usado no link no fim das mensagens.
APP_URL=

# Segundo fator do login: ligado sempre que houver canal de alerta configurado.
# "off" desliga — só para emergência, se os canais caírem.
LOGIN_2FA=on
